rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    function isAdminOf(groupId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.adminIds;
    }
    function isMemberOf(groupId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }
    function isSyngAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(uid);
      allow update: if isAuthenticated() && isOwner(uid);
      allow delete: if false;
      match /notifications/{notifId} {
        allow read, write: if request.auth.uid == uid;
      }
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.groupId != null && isMemberOf(resource.data.groupId))
      );
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.groupId != null && isMemberOf(resource.data.groupId))
      );
      allow delete: if false;
    }

    match /reminders/{id} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /groups/{groupId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.adminIds;
      allow update: if isAuthenticated();
      allow delete: if false;
      match /members/{memberId} {
        allow read:   if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAdminOf(groupId);
        allow delete: if isAdminOf(groupId) || isOwner(memberId);
      }
    }

    match /invitations/{invitationId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /activity_log/{logId} {
      allow create: if request.auth != null
        && request.resource.data.actor_id == request.auth.uid
        && request.resource.data.event_action is string
        && request.resource.data.group_id is string;
      allow read: if request.auth != null
        && resource.data.actor_id == request.auth.uid;
      allow update, delete: if false;
    }

    match /subscriptions/{uid} {
      allow read: if isAuthenticated() && (isOwner(uid) || isSyngAdmin());
      allow create: if isAuthenticated() && isOwner(uid)
        && request.resource.data.userId == uid
        && request.resource.data.planId == 'gratis'
        && request.resource.data.status == 'active';
      allow update: if isSyngAdmin() || (
        isAuthenticated() && isOwner(uid)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.planId == resource.data.planId
        && request.resource.data.status == resource.data.status
        && request.resource.data.get('source', 'auto') == resource.data.get('source', 'auto')
        && request.resource.data.movementTotal >= resource.data.get('movementTotal', 0)
        && request.resource.data.movementMonthCount >= 0
      );
      allow delete: if false;
    }

    match /subscription_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isSyngAdmin();
    }

    match /system_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSyngAdmin();
    }

    match /admin_users/{uid} {
      allow read: if isAuthenticated() && isOwner(uid);
      allow write: if isSyngAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSyngAdmin();
      allow write: if false;
    }

    match /promotores/{promotorId} {
      allow read: if isAuthenticated();
      allow write: if isSyngAdmin();
    }

    match /comisiones/{comisionId} {
      allow read: if isSyngAdmin();
      allow write: if isSyngAdmin();
    }

    match /retiros/{retiroId} {
      allow read: if isSyngAdmin();
      allow write: if isSyngAdmin();
    }

    match /audit_log/{logId} {
      allow read: if isSyngAdmin();
      allow write: if isSyngAdmin();
    }

    match /feature_flags/{flagId} {
      allow read: if isAuthenticated();
      allow write: if isSyngAdmin();
    }

    match /free_tier_by_phone/{phone} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber == phone;
      allow update, delete: if false;
    }

    match /device_links/{deviceId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }
  }
}
